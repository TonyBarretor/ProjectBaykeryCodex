generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentProvider {
  CULQI
  MERCADO_PAGO
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  REFUNDED
  FAILED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  COMPLETED
  CANCELLED
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accounts  Account[]
  sessions  Session[]
  orders    Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String
  pricePEN      Decimal        @db.Decimal(10, 2)
  costPEN       Decimal        @db.Decimal(10, 2)
  status        String
  weekendOnly   Boolean        @default(false)
  allergens     String[]
  images        Json
  stock         Int            @default(0)
  sku           String?
  tags          String[]
  leadTimeDays  Int            @default(2)
  availableFrom DateTime?
  availableTo   DateTime?
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderItems    OrderItem[]
}

model DeliveryZone {
  id        String   @id @default(cuid())
  name      String
  feePEN    Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  orders    Order[]
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minSubtotalPEN Decimal    @db.Decimal(10, 2) @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  uses           Int        @default(0)
  maxUses        Int?
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  orders         Order[]
}

model Order {
  id                String        @id @default(cuid())
  userId            String?
  email             String
  items             OrderItem[]
  subtotalPEN       Decimal       @db.Decimal(10, 2)
  deliveryFeePEN    Decimal       @db.Decimal(10, 2)
  discountPEN       Decimal       @db.Decimal(10, 2) @default(0)
  totalPEN          Decimal       @db.Decimal(10, 2)
  paymentProvider   PaymentProvider
  paymentStatus     PaymentStatus @default(PENDING)
  providerRef       String?
  deliveryDate      DateTime
  deliveryWindow    String
  zoneId            String?
  zone              DeliveryZone? @relation(fields: [zoneId], references: [id])
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  status            OrderStatus   @default(PENDING)
  customerNotes     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  nameSnapshot      String
  priceSnapshotPEN  Decimal @db.Decimal(10, 2)
  qty               Int
  order             Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product @relation(fields: [productId], references: [id])
}

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  json      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BakeSlot {
  id            String   @id @default(cuid())
  deliveryDate  DateTime
  deliveryWindow String
  capacity      Int
  reserved      Int      @default(0)

  @@unique([deliveryDate, deliveryWindow])
}
